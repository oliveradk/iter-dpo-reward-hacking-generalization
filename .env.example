# Copy to .env and fill in what you need. Loaded by the pipeline via dotenv;
# in cloud environments the same names can arrive as plain env vars instead.

# Required for almost everything: LLM judges, pairwise filters, embeddings,
# and --provider openai (generation + fine-tuning jobs).
OPENAI_API_KEY=

# nl_gameable programmatic graders' runtime LLM helpers (llm_count,
# llm_rubric_score, ...).
OPENROUTER_API_KEY=

# opus_strict misalignment judges + the alignment_faking eval.
ANTHROPIC_API_KEY=

# Modal backend (--provider modal): your Modal workspace name
# and the vLLM server API key (must equal the `vllm-api-key` Modal secret).
MODAL_WORKSPACE=
MODAL_VLLM_API_KEY=

# Optional, per training backend.
TINKER_API_KEY=
TOGETHER_API_KEY=
WANDB_API_KEY=
